@using WoWsShipBuilder.DataStructures.Ship
@inherits ReactiveComponentBase<WoWsShipBuilder.Features.ShipStats.ViewModels.ShipModuleViewModel>
@inject ILocalizer Localizer

@if (ViewModel is not null)
{
    <MudCard Outlined="true" Class="pt-2 pb-1 px-md-2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" Style="overflow-x: auto;">
            @foreach (var columnUpgrade in ViewModel.ShipUpgrades)
            {
                <MudStack AlignItems="AlignItems.Center">
                    @foreach (var upgrade in columnUpgrade)
                    {
                        var isSelected = ViewModel.SelectedModules.Contains(upgrade);
                        if (columnUpgrade.IndexOf(upgrade) != 0)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Class="mt-n3 mb-n2"/>
                        }
                        <MudButton OnClick="@(_ => ViewModel.SelectModuleExecute(upgrade))" Class="pa-2 mb-n2" Style="@GetImageStyle()" Variant="Variant.Outlined" >
                            <MudImage Width="@GetImageSize()" Height="@GetImageSize()" Src="@GetModuleIcon(upgrade, isSelected)" Class=@(isSelected ? "" : "image-filter-invert-50")/>
                        </MudButton>
                        <MudText Style="@($"min-height: {(columnUpgrade.IndexOf(upgrade) == columnUpgrade.Count - 1 ? "20" : "40")}px; max-width: {(ViewModel.ShipUpgrades.Count > 5 ? "62" : "80")}px; max-height: 40px; overflow: hidden; white-space: break-spaces; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; font-size: small")" Align="Align.Center" Typo="Typo.body2">
                            @Localizer.GetGameLocalization(upgrade.Name).Localization
                        </MudText>
                    }
                </MudStack>
            }
        </MudStack>
    </MudCard>
}

@code {

    [CascadingParameter]
    private Breakpoint Breakpoint { get; set; }

    private string GetModuleIcon(ShipUpgrade upgrade, bool isSelected)
    {
        string uriSuffix = isSelected ? "_installed" : string.Empty;
        var path = $"/_content/WoWsShipBuilder.Common/assets/modules/icon_module_{upgrade.UcType.ToString()}{uriSuffix}.png";
        return path;
    }

    private int GetImageSize()
    {
        switch (Breakpoint)
        {
            case Breakpoint.Xs:
            case Breakpoint.Sm:
                return 30;
            default:
                return 40;
        }
    }

    private string GetImageStyle()
    {
        switch (Breakpoint)
        {
            case Breakpoint.Xs:
            case Breakpoint.Sm:
                return "min-width: 45px; width: 45px; height: 45px;";
            default:
                return "min-width: 55px; width: 55px; height: 55px;";
        }
    }
}
