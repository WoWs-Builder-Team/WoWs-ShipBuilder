@page "/recommended-builds-editor"
@using System.Collections.Concurrent
@using System.Collections.Immutable
@using System.Globalization
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Options
@using Prometheus
@using WoWsShipBuilder.DataStructures
@using WoWsShipBuilder.DataStructures.Modifiers
@using WoWsShipBuilder.DataStructures.Ship
@using WoWsShipBuilder.Features.Builds
@using WoWsShipBuilder.Features.Navigation
@using WoWsShipBuilder.Features.Settings
@using WoWsShipBuilder.Infrastructure.ApplicationData
@using WoWsShipBuilder.Infrastructure.Localization.Resources
@using WoWsShipBuilder.Features.ShipStats.Components
@using WoWsShipBuilder.Features.ShipStats.ViewModels
@using WoWsShipBuilder.Infrastructure.GameData
@using WoWsShipBuilder.Infrastructure.Metrics
@using WoWsShipBuilder.Infrastructure.Utility
@using WoWsShipBuilder.Features.Builds.Components

@inherits ReactiveComponentBase<ShipBuildViewModel>

@inject ILocalizer Localizer
@inject AppSettings AppSettings
@inject IOptions<CdnOptions> CdnOptions
@inject IHostEnvironment Environment
@inject MetricsService MetricsService

<MudBreakpointProvider @ref="breakpointProvider">
    <MudContainer Fixed Style="overflow-y: hidden; scrollbar-color: transparent transparent">
        <MudGrid Justify="Justify.Center" Spacing="2">
            <MudItem xs="12">
                <MudTabs Elevation="2" Position="Position.Top" HideSlider Centered Outlined Border Style="margin-top: 17px;" Class="ship-stats-tabs mt-1" PanelClass="pt-2" @ref="sectionTabs" ActivePanelIndexChanged="@(async _ => await OnSectionPanelChanged())">
                    <MudTabPanel Text="@Localizer.SimpleAppLocalization(nameof(Translation.RecommendedBuildsEditor_BuildEditor))" Tag="@("BuildEditor")" ID="@("BuildEditor")" @key="@("BuildEditor")" Style="min-width: 100%;">
                        <MudGrid Justify="Justify.Center" Spacing="2">
                            <MudItem xs="12" md="2">
                                <MudTextField Style="max-height: 52px" Class="mt-0" AutoFocus T="string" FullWidth Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Variant="Variant.Outlined" Placeholder="@Localizer.SimpleAppLocalization(nameof(Translation.ShipSelectionWindow_SearchShip))" @bind-Text="@InputText" Immediate="true" DebounceInterval="150" Margin="Margin.Normal"/>
                                <MudPaper Outlined Style="@(IsSmallScreen() ? "min-height: 300px; max-height: 300px; overflow: auto" : "height: 83vh; overflow: auto")">
                                    <MudList Dense T="KeyValuePair<string, List<RecommendedBuild>>">
                                        <MudVirtualize Items="filteredRecommendedBuildsList" Context="pair">
                                            <MudListItem @key="@pair.Key" Value="@pair.Value" OnClick="@(_ => SelectShip(pair.Key))">
                                                <MudStack Style="align-items: stretch" Class="my-n1" Spacing="1">
                                                    <MudText>
                                                        @Localizer.SimpleGameLocalization(pair.Key + "_FULL")
                                                    </MudText>
                                                    <MudText Style="text-overflow: ellipsis; overflow: hidden" Typo="Typo.body2" Class="ml-2 mt-n1">
                                                        @(pair.Value.Count + " builds")
                                                    </MudText>
                                                </MudStack>
                                            </MudListItem>
                                            <MudDivider/>
                                        </MudVirtualize>
                                    </MudList>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="12" md="10">
                                <MudDynamicTabs ActivePanelIndexChanged="@OnActivePanelChanged" Centered Position="Position.Top" HideSlider CloseTab="@RemoveTab" @ref="mudTabs" Elevation="2" PanelClass="py-6" Outlined Border Class="ship-stats-tabs">
                                    <ChildContent>
                                        @if (ViewModel is not null)
                                        {
                                            foreach (var recommendedBuild in selectedShipRecommendedBuilds)
                                            {
                                                <MudTabPanel Text="@(string.IsNullOrWhiteSpace(vmCache[recommendedBuild.BuildContainer.Id].ViewModel.BuildName) ? Build.DefaultBuildName : vmCache[recommendedBuild.BuildContainer.Id].ViewModel.BuildName)" Tag="@recommendedBuild.BuildContainer.Id" ID="@recommendedBuild.BuildContainer.Id" @key="@recommendedBuild.BuildContainer.Id">
                                                    <MudStack Spacing="2" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-n4">
                                                        <MudStack Row="@(!IsSmallScreen())" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-n1 full-width">
                                                            <MudTextField Class="mb-1 mt-0 text-field-text-align-center full-width" @bind-Value="ViewModel!.BuildName" Label="@($"{Localizer.SimpleAppLocalization(nameof(Translation.ChartsWeb_Build))}:")" AutoFocus Immediate DebounceInterval="100" Placeholder="@Localizer.SimpleAppLocalization(nameof(Translation.BuildNameDialog_EnterBuildName))" Variant="Variant.Outlined" Margin="Margin.Dense" Validation="@(new Func<string, string?>(BuildValidation.ValidateBuildName))"/>
                                                            <MudStack Row Class="align-center full-width" Justify="Justify.Center" AlignItems="AlignItems.Center">
                                                                @if (IsSmallScreen())
                                                                {
                                                                    <MudStack Class="align-center">
                                                                        <MudText Typo="Typo.body2" Style="font-size: large; font-weight: bold; align-self: center;" Align="Align.Center">
                                                                            @selectedShip!.Tier.ToTierString()
                                                                        </MudText>
                                                                        <MudIcon Icon="@Helpers.GetIconFromClass(selectedShip!.ShipClass, selectedShip.ShipCategory)" Size="Size.Medium" ViewBox="-1 -1 24 10"/>
                                                                    </MudStack>
                                                                }
                                                                else
                                                                {
                                                                    <MudIcon Icon="@Helpers.GetIconFromClass(selectedShip!.ShipClass, selectedShip.ShipCategory)" Size="Size.Large" ViewBox="-1 -1 24 10"/>
                                                                    <MudText Typo="Typo.body2" Style="font-size: x-large; font-weight: bold; align-self: center;" Align="Align.Center">
                                                                        @selectedShip.Tier.ToTierString()
                                                                    </MudText>
                                                                }
                                                                <MudText Typo="Typo.body2" Style="@(IsSmallScreen() ? "font-size: large;" : "font-size: x-large;" + "font-weight: bold;")">
                                                                    @Localizer.GetGameLocalization(selectedShip!.Index + "_FULL").Localization
                                                                </MudText>
                                                            </MudStack>
                                                            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" FullWidth Class="mb-n1 mt-n2 gap-2" OverrideStyles Size="Size.Small" Style="height: 40px">
                                                                <MudButton Disabled="@(selectedShip!.ShipCategory != ShipCategory.TechTree)" OnClick="ApplyBuildToPrevInLine">
                                                                    Apply to all prev.
                                                                </MudButton>
                                                                <MudButton Disabled="@(selectedShip!.ShipCategory != ShipCategory.TechTree)" OnClick="ApplyBuildToAllInlLine">
                                                                    Apply to all line
                                                                </MudButton>
                                                                <MudButton Disabled="@(selectedShip!.ShipCategory != ShipCategory.TechTree)" OnClick="ApplyBuildToNextInLine">
                                                                    Apply to all next
                                                                </MudButton>
                                                            </MudButtonGroup>
                                                        </MudStack>
                                                        @if (ViewModel is not null)
                                                        {
                                                            if (IsSmallScreen())
                                                            {
                                                                <ShipModuleSelector ViewModel="@ViewModel.ShipModuleViewModel"/>
                                                                <CaptainSkillSelector ViewModel="@ViewModel.CaptainSkillSelectorViewModel" ShipClass="@selectedShip!.ShipClass"/>
                                                                <ShipUpgradeSelector ViewModel="@ViewModel.UpgradePanelViewModel"/>
                                                                <ConsumableSelector ViewModel="@ViewModel.ConsumableViewModel"/>
                                                                <SignalSelector ViewModel="@ViewModel.SignalSelectorViewModel"/>
                                                                <MudTextField T="string" Class="full-width" AutoGrow AutoFocus Label="@Localizer.SimpleAppLocalization(nameof(Translation.RecommendedBuildsEditor_Notes))" @bind-Value="@vmCache[recommendedBuild.BuildContainer.Id].Notes" Variant="Variant.Outlined" Lines="2" Immediate DebounceInterval="100"/>
                                                            }
                                                            else
                                                            {
                                                                <MudStack Style="width: 100%" Spacing="2">
                                                                    <MudStack Row Spacing="2">
                                                                        <div style="height: 39vh; display: flex; width: 50%">
                                                                            <CaptainSkillSelector ViewModel="@ViewModel.CaptainSkillSelectorViewModel" ShipClass="@selectedShip!.ShipClass"/>
                                                                        </div>
                                                                        <MudStack Style="width: 50%" Spacing="2">
                                                                            <div style="height: 30vh; display: flex; width: 100%">
                                                                                <SignalSelector ViewModel="@ViewModel.SignalSelectorViewModel"/>
                                                                            </div>
                                                                            <div style="display: flex; width: 100% ">
                                                                                <ConsumableSelector ViewModel="@ViewModel.ConsumableViewModel" HideRightClickDisclaimer/>
                                                                            </div>
                                                                        </MudStack>
                                                                    </MudStack>
                                                                    <MudStack Row Spacing="2">
                                                                        <MudStack Style="width: 50%">
                                                                            <div style="display: flex; width: 100%;">
                                                                                <ShipUpgradeSelector ViewModel="@ViewModel.UpgradePanelViewModel"/>
                                                                            </div>
                                                                            <MudTextField T="string" Class="full-width mt-n1 build-notes-text-field-min-height" Style="max-height: 29vh; min-height: 100%;" AutoGrow Label="@Localizer.SimpleAppLocalization(nameof(Translation.RecommendedBuildsEditor_Notes))" @bind-Value="@vmCache[recommendedBuild.BuildContainer.Id].Notes" Variant="Variant.Outlined" Lines="2" MaxLines="13" Immediate DebounceInterval="100"/>
                                                                        </MudStack>
                                                                        <div style="width: 50%; display: flex;">
                                                                            <ShipModuleSelector ViewModel="@ViewModel.ShipModuleViewModel"/>
                                                                        </div>
                                                                    </MudStack>
                                                                </MudStack>
                                                            }
                                                        }
                                                    </MudStack>
                                                </MudTabPanel>
                                            }
                                        }
                                    </ChildContent>
                                    <Header>
                                        <MudStack Row Spacing="0">
                                            <MudDivider Vertical/>
                                            <MudTooltip Text="Add Build" Arrow Delay="350">
                                                <MudIconButton Disabled="@(selectedShip is null)" Icon="@Icons.Material.Filled.Add" OnClick="@(_ => AddNewBuild())" Color="Color.Primary"/>
                                            </MudTooltip>
                                        </MudStack>
                                    </Header>
                                </MudDynamicTabs>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    <MudTabPanel Text="Publish" Tag="@("Publish")" ID="@("Publish")" @key="@("Publish")" Style="min-width: 100%;">
                        <MudGrid Justify="Justify.Center" Spacing="2">
                            <MudItem xs="12" md="2">
                                <MudTextField Style="max-height: 52px" Class="mt-0" AutoFocus T="string" FullWidth Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Variant="Variant.Outlined" Placeholder="@Localizer.SimpleAppLocalization(nameof(Translation.ShipSelectionWindow_SearchShip))" @bind-Text="@InputTextPublication" Immediate="true" DebounceInterval="150" Margin="Margin.Normal"/>
                                <MudPaper Outlined Style="@(IsSmallScreen() ? "min-height: 300px; max-height: 300px; overflow: auto" : "height: 74vh; overflow: auto")">
                                    <MudList Dense T="KeyValuePair<string, List<RecommendedBuild>>">
                                        <MudVirtualize Items="filteredBuildsForPublication" Context="pair">
                                            <MudListItem @key="@pair.Key" Value="@pair.Value" OnClick="@(async _ => await SelectShipPreview(pair.Key))">
                                                <MudStack Style="align-items: stretch" Class="my-n1" Spacing="1">
                                                    <MudText>
                                                        @Localizer.SimpleGameLocalization(pair.Key + "_FULL")
                                                    </MudText>
                                                    <MudText Style="text-overflow: ellipsis; overflow: hidden" Typo="Typo.body2" Class="ml-2 mt-n1">
                                                        @(pair.Value.Count + " builds")
                                                    </MudText>
                                                </MudStack>
                                            </MudListItem>
                                            <MudDivider/>
                                        </MudVirtualize>
                                    </MudList>
                                </MudPaper>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Class="mt-2" Style="height: 52px">
                                    Publish builds
                                </MudButton>
                            </MudItem>
                            <MudItem xs="12" md="10">
                                <MudTabs Elevation="2" Position="Position.Top" HideSlider Centered Outlined Border="true" @ref="publicationTabs" Style="margin-top: 17px;" Class="ship-stats-tabs mt-0" PanelClass="pt-2" ActivePanelIndexChanged="@(index => LoadBuildViewModels(selectedShipRecommendedBuildsPreview[index]))">
                                    @foreach (var recommendedBuild in selectedShipRecommendedBuildsPreview)
                                    {
                                        <MudTabPanel Text="@recommendedBuild.BuildContainer.Build!.BuildName" Tag="@recommendedBuild.BuildContainer.Id" ID="recommendedBuild.BuildContainer.Id" @key="recommendedBuild.BuildContainer.Id">
                                            <MudStack Spacing="2">
                                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                    <div style="align-self: start; width: 112px;">
                                                        <MudImage Height="45" ObjectFit="ObjectFit.ScaleDown" Src="@($"{CdnOptions.Value.Host}{CdnOptions.Value.ShipImagePath}/{recommendedBuild.BuildContainer.Build.ShipIndex}.png")" Style="position: absolute; z-index: 10; margin-left: 15px"/>
                                                        <MudImage Height="45" Width="112" ObjectFit="ObjectFit.Cover" Src="@GetBackgroundFlag(recommendedBuild.BuildContainer.Ship.ShipNation, recommendedBuild.BuildContainer.Build.ShipIndex)" Style="position: absolute; z-index: 9"/>
                                                    </div>
                                                    <MudStack Row Class="align-center">
                                                        @if (IsSmallScreen())
                                                        {
                                                            <MudStack Class="align-center">
                                                                <MudText Typo="Typo.body2" Style="font-size: large; font-weight: bold; align-self: center;" Align="Align.Center">
                                                                    @recommendedBuild.BuildContainer.Ship.Tier.ToTierString()
                                                                </MudText>
                                                                <MudIcon Icon="@Helpers.GetIconFromClass(recommendedBuild.BuildContainer.Ship.ShipClass, recommendedBuild.BuildContainer.Ship.ShipCategory)" Size="Size.Medium" ViewBox="-1 -1 24 10"/>
                                                            </MudStack>
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Helpers.GetIconFromClass(recommendedBuild.BuildContainer.Ship.ShipClass, recommendedBuild.BuildContainer.Ship.ShipCategory)" Size="Size.Large" ViewBox="-1 -1 24 10"/>
                                                            <MudText Typo="Typo.body2" Style="font-size: x-large; font-weight: bold; align-self: center;" Align="Align.Center">
                                                                @recommendedBuild.BuildContainer.Ship.Tier.ToTierString()
                                                            </MudText>
                                                        }
                                                        <MudText Typo="Typo.body2" Style="@(IsSmallScreen() ? "font-size: large;" : "font-size: x-large;" + "font-weight: bold;")">
                                                            @Localizer.GetGameLocalization(recommendedBuild.BuildContainer.Build.ShipIndex + "_FULL").Localization
                                                        </MudText>
                                                    </MudStack>
                                                    <MudButton Style="height: 45px; width: 152px" EndIcon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Color="Color.Primary" OnClick="EditSelectedBuild">
                                                        Edit Build
                                                    </MudButton>
                                                </MudStack>
                                                @if (vmCache.TryGetValue(recommendedBuild.BuildContainer.Id, out var vm) && vm.IsDeleted)
                                                {
                                                    <MudText Style="position: absolute; z-index: 10; width: 100%; height: 100%; align-items: center; justify-content: center; display: flex; font-size: 150px; text-decoration-line: underline overline; transform: rotate(-30deg); pointer-events: none" Typo="Typo.button" Align="Align.Center" Color="Color.Primary">
                                                        REMOVED
                                                    </MudText>
                                                }
                                                @if (IsSmallScreen())
                                                {
                                                    <ShipModuleSelectorImageRender ViewModel="@shipModuleViewModel"/>
                                                    <CaptainSkillSelectorImageRender ViewModel="@captainSkillSelectorViewModel" ShipClass="@recommendedBuild.BuildContainer.Ship.ShipClass"/>
                                                    <ShipUpgradeSelectorImageRender ViewModel="@upgradePanelViewModel"/>
                                                    <ConsumableSelectorImageRender ViewModel="@consumableViewModel"/>
                                                    <SignalSelectorImageRender ViewModel="@signalSelectorViewModel"/>
                                                    <div style="display: flex; width: 100%; min-height: 100%; max-height: 100%; border: 1px solid var(--mud-palette-lines-default); padding: 8px; color: var(--mud-palette-text-primary); background-color: var(--mud-palette-surface); border-radius: var(--mud-default-borderradius); transition: box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;">
                                                        <MudText Style="word-break: break-all; max-width: 100%; display: table-caption; max-height: 100%; height: 100%;" Typo="Typo.body2">
                                                            <MultilineString InputString="@recommendedBuild.Notes"/>
                                                        </MudText>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <MudStack Row Spacing="2">
                                                        <div style="height: 34vh; display: flex; width: 50%">
                                                            <CaptainSkillSelectorImageRender ViewModel="@captainSkillSelectorViewModel" ShipClass="@recommendedBuild.BuildContainer.Ship.ShipClass"/>
                                                        </div>
                                                        <div style="height: 34vh; display: flex; width: 50%">
                                                            <SignalSelectorImageRender ViewModel="@signalSelectorViewModel"/>
                                                        </div>
                                                    </MudStack>
                                                    <MudStack Row Spacing="2" Style="height: 8.3vh">
                                                        <div style="display: flex; width: 50%">
                                                            <ShipUpgradeSelectorImageRender ViewModel="@upgradePanelViewModel"/>
                                                        </div>
                                                        <div style="display: flex; width: 50%">
                                                            <ConsumableSelectorImageRender ViewModel="@consumableViewModel"/>
                                                        </div>
                                                    </MudStack>
                                                    <MudStack Row Spacing="2" Style="max-height: 30.95vh">
                                                        <div style="width: 50%">
                                                            <ShipModuleSelectorImageRender ViewModel="@shipModuleViewModel"/>
                                                        </div>
                                                        <div style="display: flex; width: 50%; min-height: 100%; max-height: 100%; border: 1px solid var(--mud-palette-lines-default); padding: 8px 8px 8px 8px; color: var(--mud-palette-text-primary); background-color: var(--mud-palette-surface); border-radius: var(--mud-default-borderradius); transition: box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;">
                                                            <MudText Style="white-space: break-spaces; max-width: 100%; display: table-caption; max-height: 100%; height: 100%; overflow-y: scroll" Typo="Typo.body2">
                                                                <MultilineString InputString="@recommendedBuild.Notes"/>
                                                            </MudText>
                                                        </div>
                                                    </MudStack>
                                                }
                                            </MudStack>
                                        </MudTabPanel>
                                    }
                                </MudTabs>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudBreakpointProvider>


@code {
    private MudBreakpointProvider breakpointProvider = null!;
    private MudTabs sectionTabs = null!;
    private MudTabs mudTabs = null!;
    private Ship? selectedShip;
    private RecommendedBuild? selectedBuild;
    private List<RecommendedBuild> selectedShipRecommendedBuilds = [];
    private readonly Dictionary<string, List<RecommendedBuild>> recommendedBuilds = new();
    private readonly Dictionary<string, List<RecommendedBuild>> filteredRecommendedBuildsList = new();
    private readonly ConcurrentDictionary<Guid, RecommendedBuildViewModel> vmCache = new();
    private bool updateTab;
    private string inputText = string.Empty;
    private string InputText
    {
        get => inputText;
        set
        {
            inputText = value;
            ApplyFilter(recommendedBuilds, filteredRecommendedBuildsList, InputText);
        }
    }

    private readonly Dictionary<string, List<RecommendedBuild>> buildsForPublication = new();
    private ShipModuleViewModel shipModuleViewModel = null!;
    private SignalSelectorViewModel signalSelectorViewModel = null!;
    private CaptainSkillSelectorViewModel captainSkillSelectorViewModel = null!;
    private UpgradePanelViewModelBase upgradePanelViewModel = null!;
    private ConsumableViewModel consumableViewModel = null!;
    private Ship? selectedShipPreview;
    private List<RecommendedBuild> selectedShipRecommendedBuildsPreview = [];
    private MudTabs publicationTabs = null!;
    private readonly Dictionary<string, List<RecommendedBuild>> filteredBuildsForPublication = new();
    private RecommendedBuild? selectedBuildPreview;
    private string inputTextPublication = string.Empty;
    private string InputTextPublication
    {
        get => inputTextPublication;
        set
        {
            inputTextPublication = value;
            ApplyFilter(buildsForPublication, filteredBuildsForPublication, InputTextPublication);
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        GetAvailableBuilds();
        ApplyFilter(recommendedBuilds, filteredRecommendedBuildsList, InputText);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (updateTab && selectedBuild is not null)
        {
            mudTabs.ActivatePanel(selectedBuild.BuildContainer.Id, true);
        }

        updateTab = false;
    }

    private void ApplyFilter(Dictionary<string, List<RecommendedBuild>> sourceCollection, Dictionary<string, List<RecommendedBuild>> destinationCollection, string searchText)
    {
        var builds = sourceCollection
            .Where(x => ShipFilter(x.Key, searchText))
            .OrderBy(x => Localizer.SimpleGameLocalization($"{x.Key}_FULL"));
        destinationCollection.Clear();
        foreach (var build in builds)
        {
            if (destinationCollection.TryGetValue(build.Key, out var value))
            {
                value.AddRange(build.Value);
            }
            else
            {
                destinationCollection.Add(build.Key, build.Value);
            }
        }

        StateHasChanged();
    }

    private bool ShipFilter(string shipIndex, string textSearch)
    {
        var result = string.IsNullOrWhiteSpace(textSearch);
        if (!result)
        {
            result = AppSettings.SelectedLanguage.CultureInfo.CompareInfo.IndexOf(Localizer.SimpleGameLocalization($"{shipIndex}_FULL"), textSearch, CompareOptions.IgnoreNonSpace | CompareOptions.IgnoreCase) != -1;
        }

        return result;
    }

    private void SelectShip(string shipIndex, RecommendedBuild? build = null)
    {
        selectedShip = AppData.ShipDictionary[shipIndex];
        selectedShipRecommendedBuilds = recommendedBuilds[shipIndex];
        if (build is not null && !selectedShipRecommendedBuilds.Contains(build))
        {
            selectedShipRecommendedBuilds.Add(build);
            if (vmCache.TryGetValue(build.BuildContainer.Id, out var vm) && vm.IsDeleted)
            {
                vm.IsDeleted = false;
            }
        }

        if (selectedShipRecommendedBuilds.Any())
        {
            selectedBuild = selectedShipRecommendedBuilds[0];
            UpdateViewModel();
            updateTab = true;
        }
        else
        {
            AddNewBuild();
        }
    }

    private void UpdateViewModel()
    {
        ViewModel = null;
        if (selectedBuild is not null)
        {
            if (vmCache.TryGetValue(selectedBuild.BuildContainer.Id, out var vm))
            {
                ViewModel = vm.ViewModel;
            }
            else
            {
                ViewModel = LoadShipViewModel(selectedBuild.BuildContainer);
                vmCache.TryAdd(selectedBuild.BuildContainer.Id, new(ViewModel));
            }
        }
    }

    private ShipBuildViewModel LoadShipViewModel(ShipBuildContainer container)
    {
        MetricsService.ShipViewCount.WithLabels(selectedShip!.Index, Localizer.GetGameLocalization(selectedShip.Index + "_FULL", AppConstants.DefaultCultureDetails).Localization).Inc();
        using (MetricsService.ShipViewModelInitDurationAverage.NewTimer())
        using (MetricsService.ShipViewModelInitDuration.NewTimer())
        {
            return ShipBuildViewModel.Create(container);
        }
    }

    private static RecommendedBuild CreateRecommendedBuild(string shipIndex, Build? build = null, Guid? id = null)
    {
        if (id is not null)
        {
            var shipBuildContainer = new ShipBuildContainer(AppData.ShipDictionary[shipIndex], build, id.Value, ImmutableArray<int>.Empty, false, null, ImmutableList<Modifier>.Empty);
            return new (shipBuildContainer, string.Empty);
        }

        return new (ShipBuildContainer.CreateNew(AppData.ShipDictionary[shipIndex], build, ImmutableArray<int>.Empty), string.Empty);
    }

    private void AddNewBuild()
    {
        selectedShipRecommendedBuilds.Add(CreateRecommendedBuild(selectedShip!.Index));
        selectedBuild = selectedShipRecommendedBuilds.Last();
        UpdateViewModel();
        if (vmCache.TryGetValue(selectedBuild!.BuildContainer.Id, out var vm))
        {
            vm.IsNew = true;
        }
        updateTab = true;
    }

    private void RemoveTab(MudTabPanel panel)
    {
        var deletedBuild = selectedShipRecommendedBuilds.Single(x => x.BuildContainer.Id.Equals(panel.ID));
        var index = selectedShipRecommendedBuilds.IndexOf(deletedBuild);
        selectedShipRecommendedBuilds.Remove(deletedBuild);
        if (vmCache.TryGetValue(selectedBuild!.BuildContainer.Id, out var vm))
        {
            if (vm.IsNew)
            {
                vmCache.TryRemove(selectedBuild!.BuildContainer.Id, out _);
            }
            else
            {
                vm.IsDeleted = true;
            }
        }

        if (mudTabs.ActivePanel?.ID?.Equals(panel.ID) ?? false)
        {
            selectedBuild = null;

            if (selectedShipRecommendedBuilds.Count > index && index != -1)
            {
                selectedBuild = selectedShipRecommendedBuilds[index];
            }
            else if (selectedShipRecommendedBuilds.Any())
            {
                selectedBuild = selectedShipRecommendedBuilds.Last();
            }

            if (selectedBuild is not null)
            {
                mudTabs.ActivatePanel(selectedBuild.BuildContainer.Id);
            }
        }

        UpdateViewModel();
    }

    private void OnActivePanelChanged(int newIndex)
    {
        selectedBuild = selectedShipRecommendedBuilds.Any() ? selectedShipRecommendedBuilds.Count > newIndex ? selectedShipRecommendedBuilds[newIndex] : selectedShipRecommendedBuilds[newIndex - 1] : null;
        UpdateViewModel();
    }

    //TODO: implement correctly once DB is available
    private void GetAvailableBuilds()
    {
        foreach (var index in AppData.ShipDictionary.Keys)
        {
            recommendedBuilds.Add(index, RetrieveBuildsFromDb(index)?.Select(build => CreateRecommendedBuild(index, Build.CreateBuildFromString(build))).ToList() ?? []);
        }
    }
