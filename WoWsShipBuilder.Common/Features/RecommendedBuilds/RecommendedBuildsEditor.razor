    private string GetBackgroundFlag(Nation shipNation, string shipIndex)
    {
        var imgName = shipIndex;
        if (!File.Exists(Path.Combine(Environment.ContentRootPath, "wwwroot", "assets", "nation_flags", $"flag_{shipIndex}.png")))
        {
            imgName = shipNation.ToString();
        }

        return $"/_content/WoWsShipBuilder.Common/assets/nation_flags/flag_{imgName}.png";
    }

    private void LoadBuildViewModels(RecommendedBuild recommendedBuild)
    {
        if (selectedShipPreview is not null)
        {
            signalSelectorViewModel = new();
            captainSkillSelectorViewModel = new(selectedShipPreview.ShipClass, CaptainSkillSelectorViewModel.LoadParams(selectedShipPreview.ShipNation));
            shipModuleViewModel = new(selectedShipPreview.ShipUpgradeInfo);
            upgradePanelViewModel = new(selectedShipPreview, AppData.ModernizationCache);
            consumableViewModel = ConsumableViewModel.Create(selectedShipPreview, new List<string>(), Logging.LoggerFactory);
        }

        if (recommendedBuild.BuildContainer.Build is not null)
        {
            signalSelectorViewModel.LoadBuild(recommendedBuild.BuildContainer.Build.Signals);
            captainSkillSelectorViewModel.LoadBuild(recommendedBuild.BuildContainer.Build.Skills, recommendedBuild.BuildContainer.Build.Captain);
            shipModuleViewModel.LoadBuild(recommendedBuild.BuildContainer.Build.Modules);
            upgradePanelViewModel.LoadBuild(recommendedBuild.BuildContainer.Build!.Upgrades);
            consumableViewModel.LoadBuild(recommendedBuild.BuildContainer.Build.Consumables);
        }

        selectedBuildPreview = recommendedBuild;

        publicationTabs.ActivatePanel(recommendedBuild.BuildContainer.Id);
    }

    private async Task SelectShipPreview(string shipIndex, RecommendedBuild? build = null)
    {
        selectedShipPreview = AppData.ShipDictionary[shipIndex];
        selectedShipRecommendedBuildsPreview = buildsForPublication[shipIndex];
        var recommendedBuild = build ?? selectedShipRecommendedBuildsPreview[0];
        LoadBuildViewModels(recommendedBuild);
        await Task.Delay(1); //required to finish loading the new tabs before selecting the ID
        publicationTabs.ActivatePanel(recommendedBuild.BuildContainer.Id, true);
    }

    private async Task OnSectionPanelChanged()
    {
        if (sectionTabs.ActivePanel?.ID?.Equals("Publish") ?? false)
        {
            UpdateViewModel();
            buildsForPublication.Clear();
            foreach (var (id, cache) in vmCache)
            {
                var shipIndex = cache.ViewModel.CurrentShip.Index;
                var originalRecommendedBuildContainer = recommendedBuilds[cache.ViewModel.CurrentShip.Index].FirstOrDefault(build => build.BuildContainer.Id == id) ?? CreateRecommendedBuild(shipIndex, null, id);
                var newShipBuildContainer = cache.ViewModel.CreateShipBuildContainer(originalRecommendedBuildContainer.BuildContainer);

                if (newShipBuildContainer.Build is not null && (cache.IsNew || cache.IsDeleted || (!originalRecommendedBuildContainer.BuildContainer.IsEquivalentTo(newShipBuildContainer) && !cache.Notes.Equals(originalRecommendedBuildContainer.Notes))))
                {
                    var newRecommendedBuildContainer = new RecommendedBuild(newShipBuildContainer, cache.Notes);
                    if (buildsForPublication.TryGetValue(shipIndex, out var value))
                    {
                        value.Add(newRecommendedBuildContainer);
                    }
                    else
                    {
                        buildsForPublication.Add(shipIndex, [newRecommendedBuildContainer]);
                    }
                }
            }

            ApplyFilter(buildsForPublication, filteredBuildsForPublication, InputTextPublication);

            if (selectedShipPreview is not null)
            {
                await SelectShipPreview(selectedShipPreview.Index);
            }
        }
    }

    private void EditSelectedBuild()
    {
        InputText = Localizer.SimpleGameLocalization($"{selectedShipPreview!.Index}_FULL");
        ApplyFilter(recommendedBuilds, filteredRecommendedBuildsList, InputText);
        SelectShip(selectedShipPreview!.Index, selectedBuildPreview);
        selectedBuild = selectedShipRecommendedBuilds.SingleOrDefault(x => x.BuildContainer.Id == (Guid)publicationTabs.ActivePanel!.ID!);
        sectionTabs.ActivatePanel("BuildEditor", true);
        mudTabs.ActivatePanel(selectedBuild!.BuildContainer.Id, true);
        updateTab = true;
    }

