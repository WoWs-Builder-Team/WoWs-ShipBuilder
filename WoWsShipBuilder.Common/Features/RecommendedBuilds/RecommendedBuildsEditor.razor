    private void ApplyBuildToAllInlLine()
    {
        UpdateViewModel();
        var currentBuild = ViewModel!.CreateShipBuildContainer(selectedBuild!.BuildContainer).Build;
        var shipSummary = AppData.ShipSummaryMapper[selectedShip!.Index];
        var previousShipIndex = shipSummary.PrevShipIndex;
        var nextShipIndex = shipSummary.NextShipIndexes?.SingleOrDefault(index => AppData.ShipDictionary[index].TechTreePosition == selectedShip!.TechTreePosition);

        PropagateBuild(previousShipIndex, currentBuild, true);
        PropagateBuild(nextShipIndex, currentBuild, false);
    }

    private void ApplyBuildToPrevInLine()
    {
        UpdateViewModel();
        var currentBuild = ViewModel!.CreateShipBuildContainer(selectedBuild!.BuildContainer).Build;
        var previousShipIndex = AppData.ShipSummaryMapper[selectedShip!.Index].PrevShipIndex;

        PropagateBuild(previousShipIndex, currentBuild, true);
    }

    private void ApplyBuildToNextInLine()
    {
        UpdateViewModel();
        var currentBuild = ViewModel!.CreateShipBuildContainer(selectedBuild!.BuildContainer).Build;
        var shipSummary = AppData.ShipSummaryMapper[selectedShip!.Index];
        var nextShipIndex = shipSummary.NextShipIndexes?
            .Where(index => AppData.ShipDictionary[index].ShipClass == shipSummary.ShipClass)
            .SingleOrDefault(index => AppData.ShipDictionary[index].TechTreePosition == selectedShip!.TechTreePosition);

        PropagateBuild(nextShipIndex, currentBuild, false);
    }

    private void PropagateBuild(string? startIndex, Build? build, bool propagateBackwards)
    {
        while (!string.IsNullOrEmpty(startIndex))
        {
            var ship = AppData.ShipDictionary[startIndex];
            var newRecommendedBuild = CreateRecommendedBuild(startIndex);
            var vm = LoadShipViewModel(newRecommendedBuild.BuildContainer);
            if (build is not null)
            {
                var shipConfiguration = ShipModuleHelper.GroupAndSortUpgrades(ship.ShipUpgradeInfo.ShipUpgrades)
                    .OrderBy(entry => entry.Key)
                    .Select(entry => entry.Value)
                    .Select(module => module[^1])
                    .Select(module => module.Name.NameToIndex());

                vm.ShipModuleViewModel.LoadBuild(shipConfiguration);
                vm.SignalSelectorViewModel.LoadBuild(build.Signals);
                vm.CaptainSkillSelectorViewModel.LoadBuild(build.Skills, build.Captain);
                vm.UpgradePanelViewModel.LoadBuild(build.Upgrades);
                vm.ConsumableViewModel.LoadBuild(build.Consumables);
                vm.BuildName = build.BuildName.Trim();
            }

            recommendedBuilds[startIndex].Add(newRecommendedBuild);
            vmCache.TryAdd(newRecommendedBuild.BuildContainer.Id, new(vm) { Notes = vmCache[selectedBuild!.BuildContainer.Id].Notes, IsNew = true});

            var summary = AppData.ShipSummaryMapper[startIndex];
            startIndex = propagateBackwards ? summary.PrevShipIndex
                : summary.NextShipIndexes?.Where(index => AppData.ShipDictionary[index].ShipClass == summary.ShipClass)
                .SingleOrDefault(index => AppData.ShipDictionary[index].TechTreePosition == ship.TechTreePosition);
        }
    }

