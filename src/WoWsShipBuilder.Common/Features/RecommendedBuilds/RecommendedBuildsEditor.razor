@page "/recommended-builds-editor"
@using System.Collections.Concurrent
@using System.Collections.Immutable
@using WoWsShipBuilder.DataStructures
@using WoWsShipBuilder.DataStructures.Modifiers
@using WoWsShipBuilder.DataStructures.Ship
@using WoWsShipBuilder.Features.Builds
@using WoWsShipBuilder.Features.Builds.Components
@using WoWsShipBuilder.Features.Navigation
@using WoWsShipBuilder.Infrastructure.ApplicationData
@using WoWsShipBuilder.Infrastructure.Localization.Resources
@using WoWsShipBuilder.Features.ShipStats.Components
@using WoWsShipBuilder.Infrastructure.GameData
@using WoWsShipBuilder.Infrastructure.Metrics
@using WoWsShipBuilder.Infrastructure.Utility

@inherits ReactiveComponentBase<ShipBuildViewModel>

@inject ILocalizer Localizer
@inject MetricsService MetricsService
@inject IJSRuntime Runtime
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<MudBreakpointProvider @ref="breakpointProvider">
    <MudContainer Fixed Style="overflow-y: hidden; scrollbar-color: transparent transparent">
        <MudGrid Justify="Justify.Center" Spacing="2">
            <MudItem xs="12">
                <MudTabs Elevation="2" Position="Position.Top" HideSlider Centered Outlined Border Style="margin-top: 17px;" Class="ship-stats-tabs mt-1" PanelClass="pt-2" @ref="sectionTabs" ActivePanelIndexChanged="@(_ => OnSectionPanelChanged())">
                    <MudTabPanel Text="@Localizer.SimpleAppLocalization(nameof(Translation.RecommendedBuildsEditor_BuildEditor))" Tag="@("BuildEditor")" ID="@("BuildEditor")" @key="@("BuildEditor")" Style="min-width: 100%;">
                        <MudGrid Justify="Justify.Center" Spacing="2">
                            <MudItem xs="12" md="2">
                                <RecommendedBuildsShipSelector @ref="editorSelector" MaxHeight="80vh" IsSmallScreen="IsSmallScreen()" List="recommendedBuilds" OnShipSelected="@(index => SelectShip(index))"/>
                            </MudItem>
                            <MudItem xs="12" md="10">
                                <MudDynamicTabs ActivePanelIndexChanged="@OnActivePanelChanged" Centered Position="Position.Top" HideSlider CloseTab="@RemoveTab" @ref="mudTabs" Elevation="2" PanelClass="py-6" Outlined Border Class="ship-stats-tabs">
                                    <ChildContent>
                                        @if (ViewModel is not null)
                                        {
                                            foreach (var recommendedBuild in selectedShipRecommendedBuilds)
                                            {
                                                <MudTabPanel Text="@GetBuildName(recommendedBuild)" Tag="@recommendedBuild.BuildContainer.Id" ID="@recommendedBuild.BuildContainer.Id" @key="@recommendedBuild.BuildContainer.Id">
                                                    <MudStack Spacing="2" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-n4">
                                                        <MudStack Row="@(!IsSmallScreen())" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-n1 full-width">
                                                            <MudTextField Class="mb-1 mt-0 text-field-text-align-center full-width" @bind-Value="ViewModel!.BuildName" Label="@($"{Localizer.SimpleAppLocalization(nameof(Translation.ChartsWeb_Build))}:")" AutoFocus Immediate DebounceInterval="100" Placeholder="@Localizer.SimpleAppLocalization(nameof(Translation.BuildNameDialog_EnterBuildName))" Variant="Variant.Outlined" Margin="Margin.Dense" Validation="@(new Func<string, string?>(BuildValidation.ValidateBuildName))"/>
                                                            <MudStack Row Class="align-center full-width" Justify="Justify.Center" AlignItems="AlignItems.Center">
                                                                @if (IsSmallScreen())
                                                                {
                                                                    <MudStack Class="align-center">
                                                                        <MudText Typo="Typo.body2" Style="font-size: large; font-weight: bold; align-self: center;" Align="Align.Center">
                                                                            @selectedShip!.Tier.ToTierString()
                                                                        </MudText>
                                                                        <MudIcon Icon="@Helpers.GetIconFromClass(selectedShip!.ShipClass, selectedShip.ShipCategory)" Size="Size.Medium" ViewBox="-1 -1 24 10"/>
                                                                    </MudStack>
                                                                }
                                                                else
                                                                {
                                                                    <MudIcon Icon="@Helpers.GetIconFromClass(selectedShip!.ShipClass, selectedShip.ShipCategory)" Size="Size.Large" ViewBox="-1 -1 24 10"/>
                                                                    <MudText Typo="Typo.body2" Style="font-size: x-large; font-weight: bold; align-self: center;" Align="Align.Center">
                                                                        @selectedShip.Tier.ToTierString()
                                                                    </MudText>
                                                                }
                                                                <MudText Typo="Typo.body2" Style="@(IsSmallScreen() ? "font-size: large;" : "font-size: x-large;" + "font-weight: bold;")">
                                                                    @Localizer.GetGameLocalization(selectedShip!.Index + "_FULL").Localization
                                                                </MudText>
                                                            </MudStack>
                                                            <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" FullWidth Class="mb-n1 mt-n2 gap-2" OverrideStyles Size="Size.Small" Style="height: 40px">
                                                                <MudButton Disabled="@(selectedShip!.ShipCategory != ShipCategory.TechTree)" OnClick="ApplyBuildToPrevInLine">
                                                                    Apply to all prev.
                                                                </MudButton>
                                                                <MudButton Disabled="@(selectedShip!.ShipCategory != ShipCategory.TechTree)" OnClick="ApplyBuildToAllInLine">
                                                                    Apply to all line
                                                                </MudButton>
                                                                <MudButton Disabled="@(selectedShip!.ShipCategory != ShipCategory.TechTree)" OnClick="ApplyBuildToNextInLine">
                                                                    Apply to all next
                                                                </MudButton>
                                                            </MudButtonGroup>
                                                        </MudStack>
                                                        @if (ViewModel is not null)
                                                        {
                                                            if (IsSmallScreen())
                                                            {
                                                                <ShipModuleSelector ViewModel="@ViewModel.ShipModuleViewModel"/>
                                                                <CaptainSkillSelector ViewModel="@ViewModel.CaptainSkillSelectorViewModel" ShipClass="@selectedShip!.ShipClass"/>
                                                                <ShipUpgradeSelector ViewModel="@ViewModel.UpgradePanelViewModel"/>
                                                                <ConsumableSelector ViewModel="@ViewModel.ConsumableViewModel"/>
                                                                <SignalSelector ViewModel="@ViewModel.SignalSelectorViewModel"/>
                                                                <MudTextField T="string" Class="full-width" AutoGrow AutoFocus Label="@Localizer.SimpleAppLocalization(nameof(Translation.RecommendedBuildsEditor_Notes))" @bind-Value="@vmCache[recommendedBuild.BuildContainer.Id].Notes" Variant="Variant.Outlined" Lines="2" Immediate DebounceInterval="100"/>
                                                            }
                                                            else
                                                            {
                                                                <MudStack Style="width: 100%" Spacing="2">
                                                                    <MudStack Row Spacing="2">
                                                                        <div style="height: 39vh; display: flex; width: 50%">
                                                                            <CaptainSkillSelector ViewModel="@ViewModel.CaptainSkillSelectorViewModel" ShipClass="@selectedShip!.ShipClass"/>
                                                                        </div>
                                                                        <MudStack Style="width: 50%" Spacing="2">
                                                                            <div style="height: 30vh; display: flex; width: 100%">
                                                                                <SignalSelector ViewModel="@ViewModel.SignalSelectorViewModel"/>
                                                                            </div>
                                                                            <div style="display: flex; width: 100% ">
                                                                                <ConsumableSelector ViewModel="@ViewModel.ConsumableViewModel" HideRightClickDisclaimer/>
                                                                            </div>
                                                                        </MudStack>
                                                                    </MudStack>
                                                                    <MudStack Row Spacing="2">
                                                                        <MudStack Style="width: 50%">
                                                                            <div style="display: flex; width: 100%;">
                                                                                <ShipUpgradeSelector ViewModel="@ViewModel.UpgradePanelViewModel"/>
                                                                            </div>
                                                                            <MudTextField T="string" Class="full-width mt-n1 build-notes-text-field-min-height" Style="max-height: 29vh; min-height: 100%;" AutoGrow Label="@Localizer.SimpleAppLocalization(nameof(Translation.RecommendedBuildsEditor_Notes))" @bind-Value="@vmCache[recommendedBuild.BuildContainer.Id].Notes" Variant="Variant.Outlined" Lines="2" MaxLines="13" Immediate DebounceInterval="100"/>
                                                                        </MudStack>
                                                                        <div style="width: 50%; display: flex;">
                                                                            <ShipModuleSelector ViewModel="@ViewModel.ShipModuleViewModel"/>
                                                                        </div>
                                                                    </MudStack>
                                                                </MudStack>
                                                            }
                                                        }
                                                    </MudStack>
                                                </MudTabPanel>
                                            }
                                        }
                                    </ChildContent>
                                    <Header>
                                        <MudStack Row Spacing="0">
                                            <MudDivider Vertical/>
                                            <MudTooltip Text="New Build" Arrow Delay="350">
                                                <MudIconButton Disabled="@(selectedShip is null)" Icon="@Icons.Material.Filled.Add" OnClick="@(_ => AddNewRecommendedBuild())" Color="Color.Primary"/>
                                            </MudTooltip>
                                            <MudTooltip Text="Import Build from String" Arrow Delay="350">
                                                <MudIconButton Disabled="@(selectedShip is null)" Icon="@Icons.Material.Filled.MenuOpen" OnClick="@(_ => ImportBuildFromString())" Color="Color.Primary"/>
                                            </MudTooltip>
                                            <MudFileUpload T="IBrowserFile" FilesChanged="@ImportBuildFromImage" Accept=".png">
                                                <ActivatorContent>
                                                    <MudTooltip Text="Import Build from Image" Arrow Delay="350">
                                                        <MudIconButton Disabled="@(selectedShip is null)" Icon="@Icons.Material.Filled.Image" Color="Color.Primary"/>
                                                    </MudTooltip>
                                                </ActivatorContent>
                                            </MudFileUpload>
                                        </MudStack>
                                    </Header>
                                </MudDynamicTabs>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                    <MudTabPanel Text="Publish" Tag="@("Publish")" ID="@("Publish")" @key="@("Publish")" Style="min-width: 100%;">
                        <MudGrid Justify="Justify.Center" Spacing="2">
                            <MudItem xs="12" md="2">
                                <RecommendedBuildsShipSelector IsSmallScreen="IsSmallScreen()" MaxHeight="74vh" List="buildsForPublication" OnShipSelected="@(index => SelectShipForPublication(index))"/>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Class="mt-2" Style="height: 52px">
                                    Publish builds
                                </MudButton>
                            </MudItem>
                            <MudItem xs="12" md="10">
                                @* ReSharper disable once ConditionalAccessQualifierIsNonNullableAccordingToAPIContract becasue it can be null on first render *@
                                <RecommendedBuildsPanel IsEditorPage VmCache="vmCache" RecommendedBuilds="selectedShipBuildsPreview" SelectedShip="selectedShipPreview" IsSmallScreen="IsSmallScreen()" OnEditBuildSelected="@(build => EditSelectedBuild(build))"/>
                            </MudItem>
                        </MudGrid>
                    </MudTabPanel>
                </MudTabs>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudBreakpointProvider>


@code {

    private RecommendedBuildsShipSelector editorSelector = null!;
    private MudBreakpointProvider breakpointProvider = null!;
    private MudTabs sectionTabs = null!;
    private MudTabs mudTabs = null!;
    private Ship? selectedShip;
    private RecommendedBuild? selectedBuild;
    private List<RecommendedBuild> selectedShipRecommendedBuilds = [];
    private readonly Dictionary<string, List<RecommendedBuild>> recommendedBuilds = new();
    private readonly ConcurrentDictionary<Guid, RecommendedBuildViewModel> vmCache = new();
    private bool updateTab;
    private readonly Dictionary<string, List<RecommendedBuild>> buildsForPublication = new();
    private List<RecommendedBuild> selectedShipBuildsPreview = [];
    private Ship? selectedShipPreview;
    private IJSObjectReference? jsModule;


    protected override void OnInitialized()
    {
        base.OnInitialized();
        GetAvailableBuilds();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            jsModule ??= await Runtime.InvokeAsync<IJSObjectReference>("import", "/_content/WoWsShipBuilder.Common/scripts/buildImageDecoder.js");
        }

        if (updateTab && selectedBuild is not null)
        {
            mudTabs.ActivatePanel(selectedBuild.BuildContainer.Id, true);
        }

        updateTab = false;
    }

    private void SelectShip(string shipIndex, RecommendedBuild? build = null)
    {
        selectedShip = AppData.ShipDictionary[shipIndex];
        selectedShipRecommendedBuilds = recommendedBuilds[shipIndex];

        if (build is not null && selectedShipRecommendedBuilds.All(x => x.BuildContainer.Id != build.BuildContainer.Id))
        {
            selectedShipRecommendedBuilds.Add(build);
            if (vmCache.TryGetValue(build.BuildContainer.Id, out var vm) && vm.IsDeleted)
            {
                vm.IsDeleted = false;
            }
        }

        if (selectedShipRecommendedBuilds.Any())
        {
            selectedBuild = selectedShipRecommendedBuilds[0];
            UpdateViewModel();
            updateTab = true;
        }
        else
        {
            AddNewRecommendedBuild();
        }
    }

    private void UpdateViewModel()
    {
        ViewModel = null;
        if (selectedBuild is not null)
        {
            if (vmCache.TryGetValue(selectedBuild.BuildContainer.Id, out var vm))
            {
                ViewModel = vm.ViewModel;
            }
            else
            {
                ViewModel = LoadShipViewModel(selectedBuild.BuildContainer);
                vmCache.TryAdd(selectedBuild.BuildContainer.Id, new(ViewModel));
            }
        }
    }

    private ShipBuildViewModel LoadShipViewModel(ShipBuildContainer container)
    {
        using (MetricsService.ShipViewModelInitDuration.NewTimer())
        {
            return ShipBuildViewModel.Create(container);
        }
    }

    private static RecommendedBuild CreateRecommendedBuild(string shipIndex, Build? build = null, Guid? id = null)
    {
        if (id is not null)
        {
            var shipBuildContainer = new ShipBuildContainer(AppData.ShipDictionary[shipIndex], build, id.Value, ImmutableArray<int>.Empty, false, null, ImmutableList<Modifier>.Empty);
            return new(shipBuildContainer, string.Empty);
        }

        return new(ShipBuildContainer.CreateNew(AppData.ShipDictionary[shipIndex], build, ImmutableArray<int>.Empty), string.Empty);
    }

    private void AddNewRecommendedBuild(Build? build = null)
    {
        selectedBuild = CreateRecommendedBuild(selectedShip!.Index, build);
        selectedShipRecommendedBuilds.Add(selectedBuild);
        selectedBuild ??= selectedShipRecommendedBuilds.Last();
        UpdateViewModel();
        if (vmCache.TryGetValue(selectedBuild.BuildContainer.Id, out var vm))
        {
            vm.IsNew = true;
        }

        updateTab = true;
    }

    private async Task ImportBuildFromImage(IBrowserFile? file)
    {
        if (file is not null && file.ContentType.Equals("image/png"))
        {
            var buildString = await jsModule!.InvokeAsync<string>("findUploadAndDecode");
            var build = Build.CreateBuildFromString(buildString);
            if(build.ShipIndex == selectedShip!.Index)
            {
                AddNewRecommendedBuild(build);
                Snackbar.Add("Build imported successfully", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Can't apply build for the ship { Localizer.SimpleGameLocalization(build.ShipIndex) } to the selected ship { Localizer.SimpleGameLocalization(selectedShip.Index) }", Severity.Error);
            }
        }
    }

    private async Task ImportBuildFromString()
    {
        var parameters = new DialogParameters
        {
            ["SelectedShipIndex"] = selectedShip!.Index,
        };
        var dialog = await DialogService.ShowAsync<BuildStringInputDialog>(Localizer.SimpleAppLocalization(nameof(Translation.BuildStringInputDialog_EnterBuildStringOrLink)), parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Build build })
        {
            AddNewRecommendedBuild(build);
            Snackbar.Add("Build imported successfully", Severity.Success);
        }
    }

    private void RemoveTab(MudTabPanel panel)
    {
        var deletedBuild = selectedShipRecommendedBuilds.Single(x => x.BuildContainer.Id.Equals(panel.ID));
        var index = selectedShipRecommendedBuilds.IndexOf(deletedBuild);
        selectedShipRecommendedBuilds.Remove(deletedBuild);
        if (vmCache.TryGetValue(selectedBuild!.BuildContainer.Id, out var vm))
        {
            if (vm.IsNew)
            {
                vmCache.TryRemove(selectedBuild!.BuildContainer.Id, out _);
            }
            else
            {
                vm.IsDeleted = true;
            }
        }

        if (mudTabs.ActivePanel?.ID?.Equals(panel.ID) ?? false)
        {
            selectedBuild = null;

            if (selectedShipRecommendedBuilds.Count > index && index != -1)
            {
                selectedBuild = selectedShipRecommendedBuilds[index];
            }
            else if (selectedShipRecommendedBuilds.Any())
            {
                selectedBuild = selectedShipRecommendedBuilds.Last();
            }

            if (selectedBuild is not null)
            {
                mudTabs.ActivatePanel(selectedBuild.BuildContainer.Id);
            }
        }

        UpdateViewModel();
    }

    private void OnActivePanelChanged(int newIndex)
    {
        selectedBuild = selectedShipRecommendedBuilds.Any() ? selectedShipRecommendedBuilds.Count > newIndex ? selectedShipRecommendedBuilds[newIndex] : selectedShipRecommendedBuilds.Last() : null;
        UpdateViewModel();
    }

    //TODO: implement correctly once DB is available
    private void GetAvailableBuilds()
    {
        foreach (var index in AppData.ShipDictionary.Keys)
        {
            if (index == "PBSD105")
            {
                RecommendedBuild testBuild1 = new(new(AppData.ShipDictionary["PBSD105"], Build.CreateBuildFromString("PBSD105;PBUA403,PBUH405,PBUT404,PBUS404,PBUE403;PCM020;PBW102;21,39;PCY009,PCY014;PCEF019,PCEF009;4;test1"), Guid.Parse("142cb6c0-4a0e-4029-a8ff-4a8af26bc55d"), ImmutableArray<int>.Empty, false, null, ImmutableList<Modifier>.Empty), "Scam build !!!");
                recommendedBuilds.Add("PBSD105", [testBuild1]);
            }
            else
            {
                recommendedBuilds.Add(index, RetrieveBuildsFromDb(index)?.Select(build => CreateRecommendedBuild(index, Build.CreateBuildFromString(build))).ToList() ?? []);
            }
        }
    }

    //TODO: implement correctly once DB is available
    private List<string>? RetrieveBuildsFromDb(string shipIndex)
    {
        return null;
    }

    private void ApplyBuildToAllInLine()
    {
        UpdateViewModel();
        var currentBuild = ViewModel!.CreateShipBuildContainer(selectedBuild!.BuildContainer).Build;
        var shipSummary = AppData.ShipSummaryMapper[selectedShip!.Index];
        var previousShipIndex = shipSummary.PrevShipIndex;
        var nextShipIndex = shipSummary.NextShipIndexes?.SingleOrDefault(index => AppData.ShipDictionary[index].TechTreePosition == selectedShip!.TechTreePosition);

        PropagateBuild(previousShipIndex, currentBuild, true);
        PropagateBuild(nextShipIndex, currentBuild, false);
    }

    private void ApplyBuildToPrevInLine()
    {
        UpdateViewModel();
        var currentBuild = ViewModel!.CreateShipBuildContainer(selectedBuild!.BuildContainer).Build;
        var previousShipIndex = AppData.ShipSummaryMapper[selectedShip!.Index].PrevShipIndex;

        PropagateBuild(previousShipIndex, currentBuild, true);
    }

    private void ApplyBuildToNextInLine()
    {
        UpdateViewModel();
        var currentBuild = ViewModel!.CreateShipBuildContainer(selectedBuild!.BuildContainer).Build;
        var shipSummary = AppData.ShipSummaryMapper[selectedShip!.Index];
        var nextShipIndex = shipSummary.NextShipIndexes?
            .Where(index => AppData.ShipDictionary[index].ShipClass == shipSummary.ShipClass)
            .SingleOrDefault(index => AppData.ShipDictionary[index].TechTreePosition == selectedShip!.TechTreePosition);

        PropagateBuild(nextShipIndex, currentBuild, false);
    }

    private void PropagateBuild(string? startIndex, Build? build, bool propagateBackwards)
    {
        while (!string.IsNullOrEmpty(startIndex))
        {
            var ship = AppData.ShipDictionary[startIndex];
            var newRecommendedBuild = CreateRecommendedBuild(startIndex);
            var vm = LoadShipViewModel(newRecommendedBuild.BuildContainer);
            if (build is not null)
            {
                var shipConfiguration = ShipModuleHelper.GroupAndSortUpgrades(ship.ShipUpgradeInfo.ShipUpgrades)
                    .OrderBy(entry => entry.Key)
                    .Select(entry => entry.Value)
                    .Select(module => module[^1])
                    .Select(module => module.Name.NameToIndex());

                vm.ShipModuleViewModel.LoadBuild(shipConfiguration);
                vm.SignalSelectorViewModel.LoadBuild(build.Signals);
                vm.CaptainSkillSelectorViewModel.LoadBuild(build.Skills, build.Captain);
                vm.UpgradePanelViewModel.LoadBuild(build.Upgrades);
                vm.ConsumableViewModel.LoadBuild(build.Consumables);
                vm.BuildName = build.BuildName.Trim();
            }

            recommendedBuilds[startIndex].Add(newRecommendedBuild);
            vmCache.TryAdd(newRecommendedBuild.BuildContainer.Id, new(vm) { Notes = vmCache[selectedBuild!.BuildContainer.Id].Notes, IsNew = true });

            var summary = AppData.ShipSummaryMapper[startIndex];
            startIndex = propagateBackwards
                ? summary.PrevShipIndex
                : summary.NextShipIndexes?.Where(index => AppData.ShipDictionary[index].ShipClass == summary.ShipClass)
                    .SingleOrDefault(index => AppData.ShipDictionary[index].TechTreePosition == ship.TechTreePosition);
        }
    }

    private bool IsSmallScreen()
    {
        return breakpointProvider.Breakpoint is Breakpoint.Xs or Breakpoint.Sm;
    }

    private void OnSectionPanelChanged()
    {
        if (sectionTabs.ActivePanel?.ID?.Equals("Publish") ?? false)
        {
            UpdateViewModel();
            buildsForPublication.Clear();
            foreach (var (id, cache) in vmCache)
            {
                var shipIndex = cache.ViewModel.CurrentShip.Index;
                var originalRecommendedBuildContainer = recommendedBuilds[shipIndex].FirstOrDefault(build => build.BuildContainer.Id == id) ?? CreateRecommendedBuild(shipIndex, null, id);
                var newShipBuildContainer = cache.ViewModel.CreateShipBuildContainer(originalRecommendedBuildContainer.BuildContainer);

                if (newShipBuildContainer.Build is not null && (cache.IsNew || cache.IsDeleted || (!originalRecommendedBuildContainer.BuildContainer.IsEquivalentTo(newShipBuildContainer) && !cache.Notes.Equals(originalRecommendedBuildContainer.Notes))))
                {
                    var newRecommendedBuildContainer = new RecommendedBuild(newShipBuildContainer, cache.Notes);
                    if (buildsForPublication.TryGetValue(shipIndex, out var builds))
                    {
                        builds.Add(newRecommendedBuildContainer);
                    }
                    else
                    {
                        buildsForPublication.Add(shipIndex, [newRecommendedBuildContainer]);
                    }
                }
            }

            if (selectedShipPreview is not null && buildsForPublication.ContainsKey(selectedShipPreview.Index))
            {
                SelectShipForPublication(selectedShipPreview.Index);
            }
        }
    }

    private void EditSelectedBuild(RecommendedBuild build)
    {
        editorSelector.InputText = Localizer.SimpleGameLocalization($"{selectedShipPreview!.Index}_FULL");
        SelectShip(selectedShipPreview!.Index, build);
        selectedBuild = selectedShipRecommendedBuilds.SingleOrDefault(x => x.BuildContainer.Id == build.BuildContainer.Id);
        sectionTabs.ActivatePanel("BuildEditor", true);
        mudTabs.ActivatePanel(selectedBuild!.BuildContainer.Id, true);
        updateTab = true;
    }

    private void SelectShipForPublication(string index)
    {
        selectedShipBuildsPreview = buildsForPublication[index];
        selectedShipPreview = AppData.ShipDictionary[index];
    }

    private string GetBuildName(RecommendedBuild build)
    {
        if (vmCache.TryGetValue(build.BuildContainer.Id, out var vm))
        {
            var buildName = vm.ViewModel.BuildName;
            return string.IsNullOrWhiteSpace(buildName) ? Build.DefaultBuildName : buildName;
        }

        return build.BuildContainer.Build?.BuildName ?? Build.DefaultBuildName;
    }
}
