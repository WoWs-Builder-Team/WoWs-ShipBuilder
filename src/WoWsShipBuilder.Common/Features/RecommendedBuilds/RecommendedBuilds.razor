        RecommendedBuild testBuild2 = new(new(AppData.ShipDictionary["PGSC506"], Build.CreateBuildFromString("PGSC506;PGUA603,PGUH605,PGUT605,PGUS605,PGUE603;PCM012;PCW001;13,6;PCY009,PCY016,PCY012,PCY010;PCEF019;4;test2"), Guid.Parse("1e24a86b-d9f2-44f1-acf8-876da95a5b5b"), ImmutableArray<int>.Empty, false, null, ImmutableList<Modifier>.Empty), "Scam build !!!");
