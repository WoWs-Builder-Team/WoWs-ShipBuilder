        RecommendedBuild testBuild3 = new(new(AppData.ShipDictionary["PBSD105"],Build.CreateBuildFromString("PBSD105;PBUA403,PBUH405,PBUT404,PBUS404,PBUE403;PCM069,PCM039,PCM037;PBW100;21,39,6,13;PCY009,PCY014;PCEF019,PCEF009,PCEF017,PCEF008;4;test3"),Guid.Parse("90f9938a-c2eb-45ba-89f3-22fbcd569587"), ImmutableArray<int>.Empty, false, null, ImmutableList<Modifier>.Empty), string.Empty);
