@page "/recommended-builds"
@using System.Collections.Immutable
@using WoWsShipBuilder.Features.Builds
@using WoWsShipBuilder.DataStructures.Modifiers
@using WoWsShipBuilder.DataStructures.Ship
@using WoWsShipBuilder.Features.Navigation
@using WoWsShipBuilder.Infrastructure.ApplicationData
@using WoWsShipBuilder.Infrastructure.Localization.Resources

@inject ILocalizer Localizer
@inject AppNavigator AppNavigator

<MudBreakpointProvider @ref="breakpointProvider">
    <MudContainer Fixed>
        <MudGrid Justify="Justify.Center" Spacing="2">
            <MudItem xs="12" md="2" Style="padding-top: 24px">
                <RecommendedBuildsShipSelector IsSmallScreen="IsSmallScreen()" List="recommendedBuilds" OnShipSelected="@(index => SelectShip(index))"/>
            </MudItem>
            <MudItem xs="12" md="8" Style="padding-top: 24px">
                <RecommendedBuildsPanel RecommendedBuilds="shipBuilds" SelectedShip="selectedShip" IsSmallScreen="IsSmallScreen()" OnBuildSelected="@(build => SelectBuild(build))"/>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Disabled="@(!selectedBuilds.Any())" Variant="Variant.Filled" Color="Color.Primary" OnClick="@GoToShipPage" FullWidth="true" Style="margin-top: 16px; margin-bottom: 8px; height: 52px">
                    @Localizer.GetAppLocalization(nameof(Translation.WebApp_GoToShipsPage)).Localization
                </MudButton>
                <MudPaper Outlined Style="@(IsSmallScreen() ? "min-height: 300px; max-height: 300px; overflow: auto" : "height: 82vh; overflow: auto")">
                    <MudList Dense T="List<RecommendedBuild>">
                        <MudVirtualize Items="selectedBuilds" Context="build">
                            <MudListItem @key="@build.BuildContainer.Id" Value="@build.BuildContainer.Build">
                                <MudStack Style="align-items: stretch" Class="my-n1" Spacing="1">
                                    <MudText>
                                        @Localizer.SimpleGameLocalization(build.BuildContainer.Ship.Index + "_FULL")
                                    </MudText>
                                    <MudText Style="text-overflow: ellipsis; overflow: hidden" Typo="Typo.body2" Class="ml-2 mt-n1">
                                        @(Localizer.GetAppLocalization(nameof(Translation.ChartsWeb_Build)).Localization + ": " + (!string.IsNullOrWhiteSpace(build.BuildContainer.Build?.BuildName) ? build.BuildContainer.Build.BuildName : Build.DefaultBuildName))
                                    </MudText>
                                </MudStack>
                            </MudListItem>
                            <MudDivider/>
                        </MudVirtualize>
                    </MudList>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudContainer>
</MudBreakpointProvider>

@code
{
