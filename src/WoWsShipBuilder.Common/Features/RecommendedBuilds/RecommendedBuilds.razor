    private readonly List<RecommendedBuild> selectedBuilds = [];
    private Ship selectedShip = null!;
    private Guid currentActiveTabId;
    private string disclaimer = string.Empty;
    private string noBuild = string.Empty;
    private string inputText = string.Empty;
    private readonly Guid noBuildTabId = Guid.NewGuid();
    private string InputText
    {
        get => inputText;
        set
        {
            inputText = value;
            ApplyFilter();
        }
    }

    private ShipModuleViewModel shipModuleViewModel = null!;
